{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumfer.com.ar/schemas/canva/template.schema.json",
  "title": "Canva Template Definition",
  "description": "Definicion reutilizable de una plantilla de Canva: variables, limites, estructura, restricciones, CTA y layout esperado.",
  "type": "object",
  "required": ["templateId", "name", "version", "aspectRatio", "maxSlides", "variables", "structure", "cta"],
  "additionalProperties": false,
  "properties": {
    "templateId": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "targetPlatform": { "type": "string" },
    "aspectRatio": { "type": "string", "enum": ["9:16", "4:5", "1:1", "16:9"] },
    "maxSlides": { "type": "integer", "minimum": 1 },
    "minSlides": { "type": "integer", "minimum": 1 },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "from", "required", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Nombre de la variable en la plantilla de Canva (ej: Titular)" },
          "from": { "type": "string", "description": "Variable semantica de origen (ej: headline)" },
          "type": { "type": "string", "enum": ["text", "asset"] },
          "required": { "type": "boolean" },
          "maxChars": { "type": "integer", "minimum": 1 },
          "slidesOnly": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "structure": {
      "type": "array",
      "description": "Secuencia esperada de roles de bloque, en orden.",
      "items": { "type": "string", "enum": ["cover", "hook", "context", "value", "proof", "cta"] }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresCta": { "type": "boolean" },
        "requiresLogoOnClose": { "type": "boolean" },
        "maxTypographyWeights": { "type": "integer" },
        "palette": { "type": "string", "enum": ["modo-oscuro", "modo-claro", "ambos"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cta": {
      "type": "object",
      "required": ["required", "position"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "position": { "type": "string", "enum": ["ultimo-slide", "cada-slide", "opcional"] },
        "defaultIntent": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "description": "Layout esperado por rol de slide (guia para el diseñador).",
      "additionalProperties": { "type": "string" }
    }
  }
}
