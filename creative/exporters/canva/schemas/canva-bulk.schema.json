{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alumfer.com.ar/schemas/canva/canva-bulk.schema.json",
  "title": "Canva Bulk Create — JSON Output",
  "description": "Estructura del bulk-create.json emitido por el Canva Exporter. El exportador auto-valida su propio output contra este schema antes de emit().",
  "type": "object",
  "required": ["template", "packageId", "slides"],
  "additionalProperties": false,
  "properties": {
    "template": { "type": "string" },
    "templateId": { "type": "string" },
    "packageId": { "type": "string", "pattern": "^CP-\\d{8}-[a-z0-9]+-[a-z0-9-]+-v\\d+$" },
    "aspectRatio": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["slide", "variables"],
        "additionalProperties": false,
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" },
          "variables": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
