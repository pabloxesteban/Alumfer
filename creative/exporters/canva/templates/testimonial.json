{
  "templateId": "testimonial",
  "name": "Testimonio Alumfer",
  "version": "1.0",
  "targetPlatform": "instagram",
  "aspectRatio": "4:5",
  "minSlides": 1,
  "maxSlides": 3,
  "variables": [
    { "name": "Cita",     "from": "headline",   "type": "text",  "required": true,  "maxChars": 160 },
    { "name": "Cliente",  "from": "attribution","type": "text",  "required": true,  "maxChars": 60 },
    { "name": "Contexto", "from": "body",       "type": "text",  "required": false, "maxChars": 120 },
    { "name": "Imagen",   "from": "image",      "type": "asset", "required": false },
    { "name": "CTA",      "from": "cta_label",  "type": "text",  "required": false, "maxChars": 32, "slidesOnly": ["cta"] },
    { "name": "Logo",     "from": "logo",       "type": "asset", "required": false, "slidesOnly": ["cta"] }
  ],
  "structure": ["proof", "cta"],
  "constraints": {
    "requiresCta": true,
    "requiresLogoOnClose": true,
    "maxTypographyWeights": 2,
    "palette": "ambos",
    "notes": [
      "La cita debe sonar real, no de folleto. Sin superlativos artificiales.",
      "Atribucion con nombre + barrio (ej: 'Marcela, Adrogue')."
    ]
  },
  "cta": { "required": true, "position": "ultimo-slide", "defaultIntent": "consulta" },
  "layout": {
    "proof": "cita grande sobre foto de la obra del cliente, atribucion al pie",
    "cta": "fondo Carbon, invitacion + WhatsApp + logo"
  }
}
