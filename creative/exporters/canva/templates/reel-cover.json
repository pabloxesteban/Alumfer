{
  "templateId": "reel-cover",
  "name": "Portada de Reel Alumfer",
  "version": "1.0",
  "targetPlatform": "instagram",
  "aspectRatio": "9:16",
  "minSlides": 1,
  "maxSlides": 1,
  "variables": [
    { "name": "Gancho", "from": "headline", "type": "text",  "required": true,  "maxChars": 60 },
    { "name": "Imagen", "from": "image",    "type": "asset", "required": true }
  ],
  "structure": ["cover"],
  "constraints": {
    "requiresCta": false,
    "requiresLogoOnClose": false,
    "maxTypographyWeights": 1,
    "palette": "ambos",
    "notes": [
      "Es la miniatura del reel: debe funcionar en la grilla del perfil.",
      "Gancho corto y legible en tamaño pequeño.",
      "Elegir el mejor frame del resultado, no un frame de proceso."
    ]
  },
  "cta": { "required": false, "position": "opcional" },
  "layout": {
    "cover": "mejor frame del resultado, gancho en tercio central seguro, sin logo"
  }
}
