{
  "templateId": "educativo",
  "name": "Educativo Alumfer",
  "version": "1.0",
  "targetPlatform": "instagram",
  "aspectRatio": "4:5",
  "minSlides": 3,
  "maxSlides": 8,
  "variables": [
    { "name": "Volanta", "from": "eyebrow",  "type": "text",  "required": false, "maxChars": 40 },
    { "name": "Titular", "from": "headline", "type": "text",  "required": true,  "maxChars": 90 },
    { "name": "Texto",   "from": "body",     "type": "text",  "required": true,  "maxChars": 220 },
    { "name": "Dato",    "from": "data",     "type": "text",  "required": false, "maxChars": 40 },
    { "name": "Imagen",  "from": "image",    "type": "asset", "required": false },
    { "name": "CTA",     "from": "cta_label","type": "text",  "required": false, "maxChars": 32, "slidesOnly": ["cta"] },
    { "name": "Logo",    "from": "logo",     "type": "asset", "required": false, "slidesOnly": ["cta"] }
  ],
  "structure": ["hook", "value", "value", "value", "cta"],
  "constraints": {
    "requiresCta": true,
    "requiresLogoOnClose": true,
    "maxTypographyWeights": 2,
    "palette": "ambos",
    "notes": [
      "Formato ideal para guardados: explicar algo que el cliente en investigacion valora.",
      "Un concepto por slide, progresion logica.",
      "Ejemplos: 'Que es el DVH', 'Como funciona el policarbonato', 'Por que el marco importa'."
    ]
  },
  "cta": { "required": true, "position": "ultimo-slide", "defaultIntent": "consulta" },
  "layout": {
    "hook": "la pregunta o el concepto central",
    "value": "un paso/concepto por slide, con apoyo visual y dato destacado",
    "cta": "'si tenes dudas sobre cual opcion es para tu caso, escribinos' + WhatsApp + logo"
  }
}
