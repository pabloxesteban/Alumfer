{
  "templateId": "instagram-carousel",
  "name": "Instagram Carousel Alumfer",
  "version": "1.0",
  "targetPlatform": "instagram",
  "aspectRatio": "4:5",
  "minSlides": 2,
  "maxSlides": 10,
  "variables": [
    { "name": "Volanta", "from": "eyebrow",   "type": "text",  "required": false, "maxChars": 40 },
    { "name": "Titular", "from": "headline",  "type": "text",  "required": true,  "maxChars": 90 },
    { "name": "Texto",   "from": "body",       "type": "text",  "required": false, "maxChars": 220 },
    { "name": "Dato",    "from": "data",       "type": "text",  "required": false, "maxChars": 40 },
    { "name": "Imagen",  "from": "image",      "type": "asset", "required": false },
    { "name": "CTA",     "from": "cta_label",  "type": "text",  "required": false, "maxChars": 32, "slidesOnly": ["cta"] },
    { "name": "Logo",    "from": "logo",       "type": "asset", "required": false, "slidesOnly": ["cta"] }
  ],
  "structure": ["hook", "value", "value", "cta"],
  "constraints": {
    "requiresCta": true,
    "requiresLogoOnClose": true,
    "maxTypographyWeights": 2,
    "palette": "ambos",
    "notes": [
      "Primer slide (hook) es el mas fuerte: define el feed.",
      "Ultimo slide siempre es CTA con logo.",
      "El azul de acento se usa con economia."
    ]
  },
  "cta": { "required": true, "position": "ultimo-slide", "defaultIntent": "consulta" },
  "layout": {
    "hook": "full-bleed-photo con titular sobre degradado inferior",
    "value": "split: imagen 60% + bloque de texto 40% con accent bar azul",
    "cta": "fondo Carbon, titular centrado, CTA WhatsApp, logo al pie"
  }
}
