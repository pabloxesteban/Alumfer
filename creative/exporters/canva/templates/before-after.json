{
  "templateId": "before-after",
  "name": "Antes y Despues Alumfer",
  "version": "1.0",
  "targetPlatform": "instagram",
  "aspectRatio": "4:5",
  "minSlides": 2,
  "maxSlides": 4,
  "variables": [
    { "name": "Etiqueta", "from": "eyebrow",  "type": "text",  "required": true,  "maxChars": 16 },
    { "name": "Titular",  "from": "headline", "type": "text",  "required": true,  "maxChars": 80 },
    { "name": "Texto",    "from": "body",     "type": "text",  "required": false, "maxChars": 180 },
    { "name": "Imagen",   "from": "image",    "type": "asset", "required": true },
    { "name": "CTA",      "from": "cta_label","type": "text",  "required": false, "maxChars": 32, "slidesOnly": ["cta"] },
    { "name": "Logo",     "from": "logo",     "type": "asset", "required": false, "slidesOnly": ["cta"] }
  ],
  "structure": ["hook", "value", "cta"],
  "constraints": {
    "requiresCta": true,
    "requiresLogoOnClose": true,
    "maxTypographyWeights": 2,
    "palette": "ambos",
    "notes": [
      "El ANTES se muestra con el mismo nivel de produccion que el DESPUES.",
      "Etiqueta 'ANTES' / 'DESPUES' en Inter uppercase.",
      "La transicion antes->despues es el momento de mayor impacto."
    ]
  },
  "cta": { "required": true, "position": "ultimo-slide", "defaultIntent": "consulta" },
  "layout": {
    "hook": "foto ANTES full-bleed con etiqueta esquina superior",
    "value": "foto DESPUES full-bleed con etiqueta y dato de resultado",
    "cta": "fondo Carbon, invitacion + WhatsApp + logo"
  }
}
