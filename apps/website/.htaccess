# ============================================================
#  Una sola dirección por página (para Google)
#  http:// y www. van a https://alumfer.com.ar con 301, y
#  /index.html va a la carpeta (/ventanas-de-aluminio/index.html
#  → /ventanas-de-aluminio/). Si el hosting termina el HTTPS en
#  un proxy, X-Forwarded-Proto evita el bucle de redirecciones.
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://alumfer.com.ar%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(([^?\s]*/)?)index\.html[?\s] [NC]
  RewriteRule ^ https://alumfer.com.ar/%1 [R=301,L]
</IfModule>

# ============================================================
#  Alumfer — Cache control
#  Evita que el navegador mezcle versiones viejas (HTML/JS) en
#  caché. El HTML se revalida siempre; los assets versionados
#  (?v=) se pueden cachear fuerte sin riesgo.
# ============================================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  # HTML: siempre revalidar (así toma los ?v= nuevos al instante)
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Estáticos: cacheables (el ?v= fuerza la actualización cuando cambian)
  <FilesMatch "\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|jfif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compresión: HTML, CSS, JS y SVG viajan ~70 % más livianos
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>
