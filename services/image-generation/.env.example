# ── OpenAI GPT Image ────────────────────────────────────────────────────────
# Clave de API de OpenAI. NUNCA se hardcodea en el código.
OPENAI_API_KEY=

# Modelo de imagen a usar. Recomendado: gpt-image-1.
# Alternativa compatible: dall-e-3.
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Selección de proveedor (opcional) ───────────────────────────────────────
# Proveedor por defecto del pipeline. Hoy: 'openai'.
# En el futuro: 'flux', 'ideogram', 'stable-diffusion', etc.
IMAGE_PROVIDER=openai
