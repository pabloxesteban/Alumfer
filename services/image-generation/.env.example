# ── OpenAI GPT Image ────────────────────────────────────────────────────────
# Clave de API de OpenAI. NUNCA se hardcodea en el código.
OPENAI_API_KEY=

# Modelo de imagen a usar. Recomendado: gpt-image-1.
# Alternativa compatible: dall-e-3.
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Selección de proveedor (opcional) ───────────────────────────────────────
# Proveedor por defecto del pipeline: 'openai' | 'midjourney'.
# En el futuro: 'flux', 'ideogram', 'stable-diffusion', etc.
IMAGE_PROVIDER=openai

# ── MidJourney (bridge NO oficial) ──────────────────────────────────────────
# ⚠️ MidJourney no tiene API oficial. Estas variables apuntan a un servicio
#    "bridge" de terceros (ImaginePro, GoAPI, apiframe, useapi, LinkrAPI…).
#    Usar un bridge puede violar los ToS de MidJourney (riesgo de ban) y suele
#    costar aparte de tu suscripción. Bajo tu propio riesgo.
#
# Clave de API del bridge (NO es tu login de MidJourney).
MIDJOURNEY_API_KEY=
# Base URL del bridge. Default: ImaginePro.
MIDJOURNEY_API_URL=https://api.imaginepro.ai
# Endpoints (ajustar según tu bridge). Defaults = ImaginePro.
MIDJOURNEY_IMAGINE_PATH=/api/v1/nova/imagine
MIDJOURNEY_FETCH_PATH=/api/v1/message/fetch/{id}
# Polling: intervalo entre chequeos y timeout total (ms).
MIDJOURNEY_POLL_INTERVAL_MS=5000
MIDJOURNEY_TIMEOUT_MS=300000
# Costo estimado por imagen en USD (informativo, opcional).
MIDJOURNEY_COST_USD=
